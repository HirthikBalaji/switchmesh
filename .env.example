# SwitchMesh Live Chat Bridges Configuration
# Copy this file to .env and fill in your platform credentials

# ==========================================
# 1. DISCORD CONFIGURATION
# ==========================================
# 1. Go to https://discord.com/developers/applications and create an Application.
# 2. Go to "Bot", click "Add Bot", copy the Token into DISCORD_BOT_TOKEN below.
# 3. Under "Privileged Gateway Intents", enable "MESSAGE CONTENT INTENT".
# 4. Under OAuth2 > URL Generator: select "bot" scope + Administrator (or Send Messages, Manage Webhooks).
# 5. Invite the bot to your Discord server.
# 6. Right-click your incident channel > Copy Channel ID.
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CHANNEL_ID="123456789012345678"

# ==========================================
# 2. SLACK CONFIGURATION (Socket Mode)
# ==========================================
# 1. Go to https://api.slack.com/apps and create an app from scratch.
# 2. Under "Socket Mode", enable Socket Mode and generate an App-level token with "connections:write".
#    Put this in SLACK_APP_TOKEN (starts with xapp-).
# 3. Under "OAuth & Permissions", add Bot Token Scopes:
#    - chat:write
#    - channels:history, groups:history, im:history, mpim:history
#    - app_mentions:read
# 4. Install the App to your workspace, copy the Bot User OAuth Token into SLACK_BOT_TOKEN (starts with xoxb-).
# 5. Right-click the channel > View channel details > Copy Channel ID (e.g. C01234567).
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_APP_TOKEN="xapp-your-slack-app-token"
SLACK_CHANNEL_ID="C0123456789"

# ==========================================
# 3. TELEGRAM CONFIGURATION
# ==========================================
# 1. Open Telegram, message @BotFather, send /newbot and follow prompts.
# 2. Copy the HTTP API token into TELEGRAM_BOT_TOKEN below.
# 3. Add the bot to your Telegram group or start a chat with it.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-100123456789"

# ==========================================
# 4. MATTERMOST CONFIGURATION (Switch Console Local)
# ==========================================
# If using Switch Console, Mattermost runs locally at http://localhost:8065
# 1. Sign in to Mattermost > Integrations > Bot Accounts > Add Bot Account.
# 2. Copy the token into MATTERMOST_BOT_TOKEN.
# 3. Channel ID is found in the channel URL or via Mattermost channel info.
MATTERMOST_URL="http://localhost:8065"
MATTERMOST_BOT_TOKEN="your_mattermost_bot_token"
MATTERMOST_CHANNEL_ID="your_channel_id"
